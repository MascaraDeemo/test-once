{
  "description": "Inject the Test Once policy and redirect configured full-suite shell commands through its single-flight cache.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/test_once_hook.py\"",
            "timeout": 5,
            "statusMessage": "Loading shared test results",
            "additionalContextLimit": 2200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/test_once_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
